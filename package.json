{
  "name": "reports-po",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^13.5.0",
    "wrangler": "^4.103.0",
    "yaml": "^2.9.0",
    "vite": "^8.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "vitest": "^5.0.0",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.0.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/write-build-metadata.js",
    "test": "vitest run",
    "test:cloudflare-shell": "node --test cloudflare/tests/*.test.mjs",
    "cf:dry-run": "wrangler deploy --config cloudflare/reports/wrangler.jsonc --dry-run",
    "cf:deploy": "wrangler deploy --config cloudflare/reports/wrangler.jsonc",
    "test:watch": "vitest",
    "lint": "eslint src vite.config.mjs eslint.config.mjs",
    "preview": "vite preview --host 127.0.0.1"
  }
}
